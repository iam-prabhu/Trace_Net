{
  "name": "collaborative-fraud-console",
  "version": "1.0.0",
  "description": "Collaborative Graph-Based Fraud Detection Console",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm test --workspace=server",
    "seed": "ts-node database/seed/seed_all.ts",
    "seed:generate": "ts-node database/seed/generate_dataset.ts",
    "seed:postgres": "ts-node database/seed/seed_postgres.ts",
    "seed:neo4j": "ts-node database/seed/seed_neo4j.ts"
  }
}
